[MAIN]
disable=all
enable=
    unused-import,
    unused-variable,
    invalid-name,
    missing-module-docstring,
    missing-function-docstring,
    too-many-arguments,
    too-many-locals,
    redefined-builtin,
    broad-exception-caught,
    dangerous-default-value

[FORMAT]
max-line-length=100

[DESIGN]
max-args=5
max-locals=3
