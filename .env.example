# Copy this file to .env and adjust values for your variant.

# CPU_LIMIT is calculated as: 1 + VARIANT_NUMBER % 2.
# Variant 72 gives 1 + 72 % 2 = 1.
VARIANT_NUMBER=72
CPU_LIMIT=1
PIDS_LIMIT=128
COMPOSE_PROJECT_NAME=devops_course

APP_REPOSITORY_URL=https://github.com/pallets/flask.git
APP_REPOSITORY_REF=3.0.3
APP_HOST=app
APP_PORT=8080
APP_PUBLIC_PORT=8080
APP_SSH_PORT=2223
APP_SSH_USER=appuser

# Public key for SSH access to app. This key is not related to tester generated keys.
# Example: APP_PUBLIC_SSH_KEY="ssh-ed25519 AAAA... user@host"
APP_PUBLIC_SSH_KEY=

TESTER_SSH_PORT=2222
TESTER_SSH_USER=tester

LOG_DIR=/work/logs
STDOUT_LOG=/work/logs/stdout.log
STDERR_LOG=/work/logs/stderr.log
