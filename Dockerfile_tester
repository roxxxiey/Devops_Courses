FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON3_VERSION=3.10.6-1~22.04.1
ARG PYTHON3_PIP_VERSION=22.0.2+dfsg-1ubuntu0.7
ARG OPENSSH_SERVER_VERSION=1:8.9p1-3ubuntu0.15
ARG OPENSSH_CLIENT_VERSION=1:8.9p1-3ubuntu0.15
ARG CA_CERTIFICATES_VERSION=20240203~22.04.1

RUN apt-get update && apt-get install -y --no-install-recommends python3=${PYTHON3_VERSION} python3-pip=${PYTHON3_PIP_VERSION} openssh-server=${OPENSSH_SERVER_VERSION} openssh-client=${OPENSSH_CLIENT_VERSION} ca-certificates=${CA_CERTIFICATES_VERSION} && rm -rf /var/lib/apt/lists/*

COPY requirements_tester.txt /tmp/requirements_tester.txt
RUN pip3 install --no-cache-dir --requirement /tmp/requirements_tester.txt

WORKDIR /work
COPY app /work/app
COPY tests /work/tests
COPY pylintrc /work/pylintrc
COPY scripts/start_tester.sh /project/scripts/start_tester.sh
COPY scripts/run_checks.sh /project/scripts/run_checks.sh

RUN chmod +x /project/scripts/*.sh && mkdir -p /run/sshd /opt/tester_keys /work/ssh/generated /work/logs && ssh-keygen -t ed25519 -N "" -f /opt/tester_keys/tester_ed25519 -C "tester-build-key" && chmod 600 /opt/tester_keys/tester_ed25519

CMD ["/project/scripts/start_tester.sh"]
